{
  "name": "animewall",
  "version": "1.0.8",
  "description": "AnimeWall desktop app",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "desktop:dev": "electron .",
    "desktop:build": "npm run build && npm run desktop:prepare",
    "desktop:start": "electron . --production",
    "desktop:dist": "npm run desktop:build && electron-builder --win",
    "desktop:prepare": "node scripts/prepare-standalone.mjs"
  },
  "type": "module",
  "main": "electron/main.mjs",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "electron-updater": "^6.6.2",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "it.animewall.desktop",
    "productName": "AnimeWall",
    "asar": true,
    "disableDefaultIgnoredFiles": true,
    "artifactName": "AnimeWall-${version}-setup.${ext}",
    "files": [
      "electron/**/*",
      "package.json",
      "node_modules/electron-updater/**/*",
      "node_modules/builder-util-runtime/**/*",
      "node_modules/fs-extra/**/*",
      "node_modules/js-yaml/**/*",
      "node_modules/lazy-val/**/*",
      "node_modules/lodash.escaperegexp/**/*",
      "node_modules/lodash.isequal/**/*",
      "node_modules/semver/**/*",
      "node_modules/tiny-typed-emitter/**/*",
      "node_modules/debug/**/*",
      "node_modules/sax/**/*"
    ],
    "asarUnpack": [
      "electron/vendor/**/*"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone"
      }
    ],
    "extraMetadata": {
      "main": "electron/main.mjs"
    },
    "win": {
      "target": "nsis",
      "icon": "electron/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "AleRabo",
        "repo": "AnimeWallApp"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
